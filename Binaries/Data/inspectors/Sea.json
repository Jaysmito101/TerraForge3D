        {
            "Name": "Enabled",
            "Type": "Bool",
            "Default": true,
            "Widget": "Checkbox",
            "Label": "Enable Sea",
            "Description": "Render the procedural sea surface over the generated terrain."
        }
    ],
    "Sections": [
        {
            "Name": "WaterLevel",
            "Label": "Water Level",
            "Description": "Controls the sea elevation.",
            "Params": [
                {
                    "Name": "SeaLevel",
                    "Type": "Float",
                    "Default": 0.07,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.0, 0.0],
                    "Label": "Sea Level",
                    "Description": "Vertical water level in terrain field units."
                }
            ]
        },
        {
            "Name": "Waves",
            "Label": "Waves",
            "Description": "Multi-octave Gerstner wave displacement.",
            "Params": [
                {
                    "Name": "WaveAmplitude",
                    "Type": "Float",
                    "Default": 5.5,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.0, 50.0],
                    "Label": "Amplitude",
                    "Description": "Peak height of the wave displacement."
                },
                {
                    "Name": "WaveFrequency",
                    "Type": "Float",
                    "Default": 0.45,
                    "Widget": "Drag",
                    "Sensitivity": 0.1,
                    "Constraints": [0.1, 100.0],
                    "Label": "Frequency",
                    "Description": "Spatial frequency of the base wave. Higher values create denser, shorter waves."
                },
                {
                    "Name": "WaveSpeed",
                    "Type": "Float",
                    "Default": 0.08,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [-10.0, 10.0],
                    "Label": "Speed",
                    "Description": "Phase velocity of wave motion. Negative reverses direction."
                }
            ]
        },
        {
            "Name": "Appearance",
            "Label": "Appearance",
            "Description": "Water color, detail, and depth behavior.",
            "Params": [
                {
                    "Name": "ShallowColor",
                    "Type": "Vector3",
                    "Default": [0.008, 0.140, 0.260],
                    "Widget": "Color",
                    "Label": "Shallow Color",
                    "Description": "Water color in shallow areas and near the surface."
                },
                {
                    "Name": "DeepColor",
                    "Type": "Vector3",
                    "Default": [0.001, 0.007, 0.030],
                    "Widget": "Color",
                    "Label": "Deep Color",
                    "Description": "Water color at maximum depth."
                },
                {
                    "Name": "DepthScale",
                    "Type": "Float",
                    "Default": 0.42,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.001, 100.0],
                    "Label": "Depth Scale",
                    "Description": "Depth at which the water reaches its deep color."
                },
                {
                    "Name": "DetailStrength",
                    "Type": "Float",
                    "Default": 0.26,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.0, 2.0],
                    "Label": "Surface Detail",
                    "Description": "How strongly surface ripples perturb the shading normal."
                }
            ]
        },
        {
            "Name": "Lighting",
            "Label": "Lighting",
            "Description": "Controls reflection, refraction, scattering, and specular highlights.",
            "Params": [
                {
                    "Name": "ReflectionStrength",
                    "Type": "Float",
                    "Default": 1.2,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.0, 4.0],
                    "Label": "Reflection",
                    "Description": "Strength of sky/environment reflection."
                },
                {
                    "Name": "RefractionStrength",
                    "Type": "Float",
                    "Default": 0.035,
                    "Widget": "Drag",
                    "Sensitivity": 0.001,
                    "Constraints": [0.0, 0.5],
                    "Label": "Refraction",
                    "Description": "Screen-space distortion of the underwater scene."
                },
                {
                    "Name": "SpecularIntensity",
                    "Type": "Float",
                    "Default": 0.75,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.0, 4.0],
                    "Label": "Sun Specular",
                    "Description": "Brightness of the sun specular highlight."
                },
                {
                    "Name": "ScatterStrength",
                    "Type": "Float",
                    "Default": 0.85,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.0, 4.0],
                    "Label": "Subsurface Scatter",
                    "Description": "Translucent glow through wave crests when backlit by the sun."
                }
            ]
        },
        {
            "Name": "Foam",
            "Label": "Foam",
            "Description": "Shore wash foam and offshore whitecaps.",
            "Params": [
                {
                    "Name": "FoamIntensity",
                    "Type": "Float",
                    "Default": 0.22,
                    "Widget": "Drag",
                    "Sensitivity": 0.01,
                    "Constraints": [0.0, 4.0],
                    "Label": "Foam Intensity",
                    "Description": "Overall brightness and opacity of all foam effects."
                },
                {
                    "Name": "ShorefoamWidth",
                    "Type": "Float",
                    "Default": 0.16,
                    "Widget": "Drag",
                    "Sensitivity": 0.005,
                    "Constraints": [0.001, 5.0],
                    "Label": "Shore Foam Width",
                    "Description": "How far the animated shore wash foam extends from the coastline."
                },
                {
                    "Name": "FoamColor",
                    "Type": "Vector3",
                    "Default": [0.720, 0.860, 0.880],
                    "Widget": "Color",
                    "Label": "Foam Color",
                    "Description": "Color of all foam effects."
                }
            ],
            "Buttons": [
                {
                    "Action": "ReloadSeaShaders",
                    "Label": "Reload Sea Shaders",
                    "Description": "Reload the sea vertex and fragment shaders after editing shader files."
                }
            ]
        }
    ]
}
