{
  "ID": "pixelate",
  "Name": "Pixelate",
  "Category": "Shaping",
  "Description": "Quantizes terrain height into broad, stable levels to create stepped terrain and terraces.",
  "Runtime": {
    "Implementation": "PhaseChain",
    "Statistics": {
      "NeedsMinMax": true,
      "NeedsHistogram": false
    },
    "Shaders": {
      "Phases": {
        "Pixelate": "generation/filters/shaping/pixelate/pixelate",
        "Merge": "generation/filters/common/merge"
      }
    },
    "Resources": {
      "Temps": [
        {
          "Name": "Pixelated",
          "Type": "Field"
        }
      ]
    },
    "Execution": {
      "Passes": [
        {
          "Phase": "Pixelate",
          "Input": "Current",
          "Output": "Pixelated",
          "Uniforms": {
            "u_Steps": {
              "Parameter": "Terraces.Steps"
            },
            "u_Offset": {
              "Parameter": "Terraces.Offset"
            }
          }
        }
      ],
      "Merge": {
        "Phase": "Merge",
        "Input": "Current",
        "Operation": "Pixelated",
        "Output": "Next"
      }
    }
  },
  "Inspector": {
    "ShowResetButton": true,
    "Sections": [
      {
        "Name": "Terraces",
        "Label": "Terraces",
        "Description": "Height quantization controls.",
        "Collapsible": true,
        "DefaultOpen": true,
        "Params": [
          {
            "Name": "Steps",
            "Type": "Int",
            "Default": 12,
            "Widget": "Slider",
            "Constraints": [
              2,
              128
            ],
            "Label": "Height steps",
            "Description": "Number of quantized levels across the current field range."
          },
          {
            "Name": "Offset",
            "Type": "Float",
            "Default": 0.0,
            "Widget": "Drag",
            "Sensitivity": 0.01,
            "Constraints": [
              -0.5,
              0.5
            ],
            "Label": "Step offset",
            "Description": "Shifts terrace boundaries as a fraction of the normalized field range.",
            "Tooltip": "Use a small offset to move the terrace breaks without changing the number of levels."
          }
        ]
      }
    ]
  }
}
