{
  "ID": "inflate_deflate",
  "Name": "Inflate / Deflate",
  "Category": "Shaping",
  "Description": "Broadly expands local highs or lows with a smooth, circular-neighborhood morphological pass.",
  "Runtime": {
    "Implementation": "PhaseChain",
    "Statistics": {
      "NeedsMinMax": true,
      "NeedsHistogram": false
    },
    "Shaders": {
      "Phases": {
        "Shape": "generation/filters/shaping/inflate_deflate/inflate_deflate",
        "Merge": "generation/filters/common/merge"
      }
    },
    "Resources": {
      "Temps": [
        {
          "Name": "Shaped",
          "Type": "Field"
        }
      ]
    },
    "Execution": {
      "Passes": [
        {
          "Phase": "Shape",
          "Input": "Current",
          "Output": "Shaped",
          "Uniforms": {
            "u_Mode": {
              "Parameter": "Direction.Mode"
            },
            "u_Radius": {
              "Parameter": "Direction.Radius"
            },
            "u_SlopeLimit": {
              "Parameter": "Slope.SlopeLimit"
            },
            "u_SlopeSoftness": {
              "Parameter": "Slope.SlopeSoftness"
            }
          }
        }
      ],
      "Merge": {
        "Phase": "Merge",
        "Input": "Current",
        "Operation": "Shaped",
        "Output": "Next"
      }
    }
  },
  "Inspector": {
    "ShowResetButton": true,
    "Sections": [
      {
        "Name": "Direction",
        "Label": "Direction",
        "Description": "Choose whether local highs or lows expand across the terrain.",
        "Collapsible": true,
        "DefaultOpen": true,
        "Params": [
          {
            "Name": "Mode",
            "Type": "Int",
            "Default": 0,
            "Widget": "Dropdown",
            "Options": [
              "Inflate uphill",
              "Deflate downhill"
            ],
            "Label": "Operation",
            "Description": "Inflate broadly expands nearby highs; Deflate broadly expands nearby lows."
          },
          {
            "Name": "Radius",
            "Type": "Int",
            "Default": 4,
            "Widget": "Slider",
            "Constraints": [
              1,
              64
            ],
            "Label": "Push distance",
            "Description": "Neighborhood radius in 1K-reference texels; the same value covers the same terrain-space area at every map resolution."
          }
        ]
      },
      {
        "Name": "Slope",
        "Label": "Slope boost",
        "Description": "Gentle terrain gets one full neighborhood pass; steeper slopes get up to twice the displacement.",
        "Collapsible": true,
        "DefaultOpen": true,
        "Params": [
          {
            "Name": "SlopeLimit",
            "Type": "Float",
            "Default": 0.0,
            "Widget": "Slider",
            "Constraints": [
              0.0,
              0.5
            ],
            "Label": "Boost threshold",
            "Description": "Slope above which the operation reaches twice its baseline displacement."
          },
          {
            "Name": "SlopeSoftness",
            "Type": "Float",
            "Default": 0.01,
            "Widget": "Slider",
            "Constraints": [
              0.0001,
              0.5
            ],
            "Label": "Boost softness",
            "Description": "Smooth transition from the baseline pass to twice its displacement."
          }
        ]
      }
    ]
  }
}
