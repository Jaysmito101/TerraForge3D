{
  "ID": "inflate_deflate",
  "Name": "Inflate / Deflate",
  "Category": "Shaping",
  "Description": "Pushes terrain uphill toward local highs or downhill toward local lows using a directional morphological pass.",
  "Runtime": {
    "Implementation": "PhaseChain",
    "Statistics": {
      "NeedsMinMax": true,
      "NeedsHistogram": false
    },
    "Shaders": {
      "Phases": {
        "Shape": "generation/filters/shaping/inflate_deflate/inflate_deflate",
        "Merge": "generation/filters/common/merge"
      }
    },
    "Resources": {
      "Temps": [
        {
          "Name": "Shaped",
          "Type": "Field"
        }
      ]
    },
    "Execution": {
      "Passes": [
        {
          "Phase": "Shape",
          "Input": "Current",
          "Output": "Shaped",
          "Uniforms": {
            "u_Mode": {
              "Parameter": "Direction.Mode"
            },
            "u_Radius": {
              "Parameter": "Direction.Radius"
            },
            "u_SlopeLimit": {
              "Parameter": "Slope.SlopeLimit"
            },
            "u_SlopeSoftness": {
              "Parameter": "Slope.SlopeSoftness"
            }
          }
        }
      ],
      "Merge": {
        "Phase": "Merge",
        "Input": "Current",
        "Operation": "Shaped",
        "Output": "Next"
      }
    }
  },
  "Inspector": {
    "ShowResetButton": true,
    "Sections": [
      {
        "Name": "Direction",
        "Label": "Direction",
        "Description": "Choose whether the local slope is pushed uphill or downhill.",
        "Collapsible": true,
        "DefaultOpen": true,
        "Params": [
          {
            "Name": "Mode",
            "Type": "Int",
            "Default": 0,
            "Widget": "Dropdown",
            "Options": [
              "Inflate uphill",
              "Deflate downhill"
            ],
            "Label": "Operation",
            "Description": "Inflate expands local highs uphill; Deflate expands local lows downhill."
          },
          {
            "Name": "Radius",
            "Type": "Int",
            "Default": 4,
            "Widget": "Slider",
            "Constraints": [
              1,
              32
            ],
            "Label": "Push distance",
            "Description": "Maximum distance sampled along the local slope in texels."
          }
        ]
      },
      {
        "Name": "Slope",
        "Label": "Slope gating",
        "Description": "Limit the operation to meaningful slopes.",
        "Collapsible": true,
        "DefaultOpen": true,
        "Params": [
          {
            "Name": "SlopeLimit",
            "Type": "Float",
            "Default": 0.0,
            "Widget": "Slider",
            "Constraints": [
              0.0,
              0.5
            ],
            "Label": "Slope limit",
            "Description": "Normalized slope below which the operation is suppressed."
          },
          {
            "Name": "SlopeSoftness",
            "Type": "Float",
            "Default": 0.01,
            "Widget": "Slider",
            "Constraints": [
              0.0001,
              0.5
            ],
            "Label": "Slope softness",
            "Description": "Smooth transition from no operation to full inflation or deflation."
          }
        ]
      }
    ]
  }
}
