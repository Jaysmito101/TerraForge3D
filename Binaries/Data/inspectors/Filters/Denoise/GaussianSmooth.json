{
  "ID": "gaussian_smooth",
  "Name": "Gaussian Smooth",
  "Category": "Denoise",
  "Description": "Smooths the field with a separable Gaussian blur and merges the result back into the filter stack.",
  "Runtime": {
    "Implementation": "PhaseChain",
    "Shaders": {
      "Phases": {
        "Blur": "generation/filters/denoise/gaussian_smooth/blur",
        "Merge": "generation/filters/denoise/gaussian_smooth/merge"
      }
    },
    "Resources": {
      "Temps": [
        {
          "Name": "BlurA",
          "Type": "Field"
        },
        {
          "Name": "BlurB",
          "Type": "Field"
        }
      ]
    },
    "Execution": {
      "Passes": [
        {
          "Phase": "Blur",
          "Input": "Current",
          "Output": "BlurA",
          "Uniforms": {
            "u_Axis": {
              "Value": 0,
              "Type": "Int"
            },
            "u_Radius": {
              "Parameter": "Smoothing.Radius"
            }
          }
        },
        {
          "Phase": "Blur",
          "Input": "BlurA",
          "Output": "BlurB",
          "Uniforms": {
            "u_Axis": {
              "Value": 1,
              "Type": "Int"
            },
            "u_Radius": {
              "Parameter": "Smoothing.Radius"
            }
          }
        }
      ],
      "IterationsParameter": "Smoothing.Iterations",
      "Merge": {
        "Phase": "Merge",
        "Input": "Current",
        "Operation": "BlurB",
        "Output": "Next"
      }
    }
  },
  "Inspector": {
    "ShowResetButton": true,
    "Sections": [
      {
        "Name": "Smoothing",
        "Label": "Smoothing",
        "Description": "Filter strength and iteration controls.",
        "Collapsible": true,
        "DefaultOpen": true,
        "Params": [
          {
            "Name": "Radius",
            "Type": "Int",
            "Default": 3,
            "Widget": "Slider",
            "Constraints": [
              0,
              64,
              0,
              0
            ],
            "Description": "The radius of the Gaussian neighborhood in texels. Larger values produce stronger smoothing."
          },
          {
            "Name": "Iterations",
            "Type": "Int",
            "Default": 1,
            "Widget": "Slider",
            "Constraints": [
              1,
              8,
              0,
              0
            ],
            "Description": "The number of blur rounds applied before the result is merged."
          }
        ]
      }
    ]
  }
}
