{
  "ID": "box_blur",
  "Name": "Box Blur",
  "Category": "Denoise",
  "Description": "A fast uniform blur for inexpensive broad smoothing and mask cleanup.",
  "Runtime": {
    "Implementation": "PhaseChain",
    "Shaders": {
      "Phases": {
        "Blur": "generation/filters/denoise/box_blur/blur",
        "Merge": "generation/filters/common/merge"
      }
    },
    "Resources": {
      "Temps": [
        {
          "Name": "BlurA",
          "Type": "Field"
        },
        {
          "Name": "BlurB",
          "Type": "Field"
        }
      ]
    },
    "Execution": {
      "Passes": [
        {
          "Phase": "Blur",
          "Input": "Current",
          "Output": "BlurA",
          "Uniforms": {
            "u_Axis": {
              "Value": 0,
              "Type": "Int"
            },
            "u_Radius": {
              "Parameter": "Smoothing.Radius"
            }
          }
        },
        {
          "Phase": "Blur",
          "Input": "BlurA",
          "Output": "BlurB",
          "Uniforms": {
            "u_Axis": {
              "Value": 1,
              "Type": "Int"
            },
            "u_Radius": {
              "Parameter": "Smoothing.Radius"
            }
          }
        }
      ],
      "Merge": {
        "Phase": "Merge",
        "Input": "Current",
        "Operation": "BlurB",
        "Output": "Next"
      }
    }
  },
  "Inspector": {
    "ShowResetButton": true,
    "Sections": [
      {
        "Name": "Smoothing",
        "Label": "Smoothing",
        "Description": "Filter strength and iteration controls.",
        "Collapsible": true,
        "DefaultOpen": true,
        "Params": [
          {
            "Name": "Radius",
            "Type": "Int",
            "Default": 3,
            "Widget": "Slider",
            "Constraints": [
              0,
              128,
              0,
              0
            ],
            "Description": "The radius of the uniform neighborhood in texels. It is fast and predictable but softer than Gaussian smoothing."
          }
        ]
      }
    ]
  }
}
