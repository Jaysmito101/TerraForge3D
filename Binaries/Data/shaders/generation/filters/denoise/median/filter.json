{
    "ID": "median_filter",
    "Name": "Median Filter",
    "Category": "Denoise",
    "Implementation": "PhaseChain",
    "Description": "Removes isolated spikes and pits while retaining strong terrain edges.",
    "Phases": {
        "Filter": "median",
        "Merge": "../../common/merge"
    },
    "Resources": {
        "Temps": [
            {
                "Name": "MedianA",
                "Type": "Field"
            },
            {
                "Name": "MedianB",
                "Type": "Field"
            }
        ]
    },
    "Execution": {
        "Passes": [
            {
                "Phase": "Filter",
                "Input": "Current",
                "Output": "MedianA",
                "Uniforms": {
                    "u_Radius": {
                        "Parameter": "Radius"
                    }
                }
            }
        ],
        "IterationMode": "PingPong",
        "IterationBuffers": [
            "MedianA",
            "MedianB"
        ],
        "IterationsParameter": "Iterations",
        "Merge": {
            "Phase": "Merge",
            "Input": "Current",
            "Operation": "IterationResult",
            "Output": "Next"
        }
    },
    "Params": [
        {
            "Name": "Radius",
            "Type": "Int",
            "Default": 1,
            "Widget": "Slider",
            "Constraints": [
                0,
                16,
                0,
                0
            ],
            "Description": "The square neighborhood radius. Median filtering removes isolated outliers without averaging across cliffs."
        },
        {
            "Name": "Iterations",
            "Type": "Int",
            "Default": 1,
            "Widget": "Slider",
            "Constraints": [
                1,
                4,
                0,
                0
            ],
            "Description": "Repeats the median operation to remove larger speckle clusters. Keep this low to preserve small landforms."
        }
    ]
}
