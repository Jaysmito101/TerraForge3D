{
  "$include": "Common/Object.json",
  "properties": {
    "Mode": {
      "type": "string",
      "enum": { "$runtime": "Viewport.Modes" }
    },
    "Camera": {
      "$include": "Common/Object.json",
      "properties": {
        "Target": { "$include": "Common/Vector3.json" },
        "Distance": { "type": "number", "exclusiveMinimum": 0.0 },
        "Azimuth": { "type": "number" },
        "Elevation": { "type": "number" },
        "FieldOfView": { "type": "number", "exclusiveMinimum": 0.0 }
      }
    },
    "Heightmap": { "$include": "Tools/Viewport/State/Heightmap.json" },
    "TextureSlot": { "$include": "Tools/Viewport/State/TextureSlot.json" },
    "Viewport": {
      "$include": "Common/Object.json",
      "properties": {
        "Visible": { "type": "boolean" },
        "ControlEnabled": { "type": "boolean" },
        "AutoCalculateAspectRatio": { "type": "boolean" }
      }
    }
  }
}
