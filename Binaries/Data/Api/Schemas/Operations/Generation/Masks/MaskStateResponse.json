{
  "type": "object",
  "properties": {
    "reference": { "$include": "Operations/Generation/OperationReference.json" },
    "kind": { "$include": "Operations/Generation/Masks/MaskKind.json" },
    "revision": { "type": "string" },
    "processedRevision": { "type": "string" },
    "dirty": { "type": "boolean" },
    "resolution": { "type": "integer", "minimum": 0 },
    "coordinateSpace": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "normalized-terrain-uv" },
        "minimum": { "type": "number", "const": 0 },
        "maximum": { "type": "number", "const": 1 },
        "uAxis": { "type": "string" },
        "vAxis": { "type": "string" },
        "resolutionMapping": { "type": "string" }
      },
      "required": ["type", "minimum", "maximum", "uAxis", "vAxis", "resolutionMapping"],
      "additionalProperties": false
    },
    "baseMask": { "$runtime": "Generation.BaseMask" },
    "baseMaskSchema": { "$include": "Operations/Generation/OperationReference.json" },
    "preview": {
      "type": "object",
      "properties": {
        "visible": { "type": "boolean" },
        "inverted": { "type": "boolean" }
      },
      "required": ["visible", "inverted"],
      "additionalProperties": false
    },
    "strokes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "pointCount": { "type": "integer", "minimum": 1 }
        },
        "required": ["index", "pointCount"],
        "additionalProperties": false
      }
    },
    "activeStroke": {
      "oneOf": [
        { "type": "object", "properties": { "pointCount": { "type": "integer", "minimum": 1 } }, "required": ["pointCount"], "additionalProperties": false },
        { "type": "null" }
      ]
    },
    "strokeCount": { "type": "integer", "minimum": 0 },
    "pointCount": { "type": "integer", "minimum": 0 },
    "allowedModes": { "type": "array", "items": { "type": "string", "enum": ["paint", "erase", "paint-negative"] } },
    "limits": {
      "type": "object",
      "properties": {
        "maxCompletedStrokes": { "type": "integer", "const": 128 },
        "maxPointsPerStroke": { "type": "integer", "const": 4096 },
        "maxPointsPerAppend": { "type": "integer", "const": 1024 },
        "maxTotalPoints": { "type": "integer", "const": 65536 },
        "brushSize": {
          "type": "object",
          "properties": {
            "minimum": { "type": "number", "const": 0.005 },
            "maximum": { "type": "number", "const": 2 }
          },
          "required": ["minimum", "maximum"],
          "additionalProperties": false
        },
        "strength": {
          "type": "object",
          "properties": {
            "minimum": { "type": "number", "const": 0 },
            "maximum": { "type": "number", "const": 1 }
          },
          "required": ["minimum", "maximum"],
          "additionalProperties": false
        },
        "falloff": {
          "type": "object",
          "properties": {
            "minimum": { "type": "number", "const": 0 },
            "maximum": { "type": "number", "const": 1 }
          },
          "required": ["minimum", "maximum"],
          "additionalProperties": false
        }
      },
      "required": ["maxCompletedStrokes", "maxPointsPerStroke", "maxPointsPerAppend", "maxTotalPoints", "brushSize", "strength", "falloff"],
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "properties": {
        "update": { "$include": "Operations/Generation/OperationReference.json" },
        "beginStroke": { "$include": "Operations/Generation/OperationReference.json" },
        "appendStroke": { "$include": "Operations/Generation/OperationReference.json" },
        "finishStroke": { "$include": "Operations/Generation/OperationReference.json" },
        "undoStroke": { "$include": "Operations/Generation/OperationReference.json" },
        "clearStrokes": { "$include": "Operations/Generation/OperationReference.json" }
      },
      "required": ["update", "beginStroke", "appendStroke", "finishStroke", "undoStroke", "clearStrokes"],
      "additionalProperties": false
    }
  },
  "required": ["reference", "kind", "revision", "processedRevision", "dirty", "resolution", "coordinateSpace", "baseMask", "baseMaskSchema", "preview", "strokes", "activeStroke", "strokeCount", "pointCount", "allowedModes", "limits", "operations"],
  "additionalProperties": false
}
